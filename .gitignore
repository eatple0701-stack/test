# Local secrets. The anon key is public-safe, but this file is where a
# service_role key would end up by accident, and that one is not.
.env
.env.local
.env.*.local

# 서울관광재단 원본 다운로드 (data.go.kr 15097605)
#
# 444MB of CSV and a text file holding the API key. Both are inputs to
# scripts/, not part of the app: what ships is public/data/seoul/, built
# from them. Committing them would put the key in the history and half a
# gigabyte in every clone.
서울관광재단*/

# Dumps, backups and debug output.
#
# Added 2026-09-01, before the repository went onto a second machine. A clone
# takes the whole history with it, and this repo handles real pilot
# participants' names and nationalities — so the check is not "is anything
# secret in the tree" but "could anything secret ever land in it by accident".
# `*.log` and `.env*` were already covered; a pg_dump or a pasted debug
# capture was not.
#
# NOT `*.sql`: the migrations and schema.sql are meant to be tracked, and
# they are how the database is reviewed before it changes.
*dump*.sql
*backup*.sql
*.dump
*.sql.gz
*debug*.txt
*debug*.json
*output*.txt
*backup*.json

# Throwaway measurement pages. Type has to be measured in a browser and the
# preview pane will not open file:// outside the repo, so these land here for
# a few minutes and are deleted. Ignored so one that outlives its session is
# never committed for the next person to puzzle over.
tmp-*
